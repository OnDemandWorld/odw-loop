{
  "name": "Weekly Campaign Digest",
  "description": "Growth team briefing: pulls weekly campaign analytics from your marketing platform, writes an executive summary, classifies the performance trend, publishes the digest to Vault and flags the growth channel when performance is trending down",
  "industry": "marketing",
  "category": "reporting",
  "featured": false,
  "icon": "📣",
  "use_cases": [
    "Send the growth team one crisp weekly performance brief",
    "Catch declining campaigns early with trend classification",
    "Keep a searchable archive of weekly campaign reports"
  ],
  "trigger": {
    "type": "cron",
    "config": { "expression": "0 9 * * 1", "timezone": "UTC" }
  },
  "definition": {
    "version": "1.0",
    "nodes": [
      {
        "id": "node_1",
        "type": "generic.rest_call",
        "position": { "x": 100, "y": 200 },
        "config": {
          "method": "GET",
          "url": "{{variables.analytics_url}}",
          "headers": { "Authorization": "Bearer {{secrets.analytics_token}}" }
        },
        "retry": { "max_attempts": 3, "backoff": "exponential", "initial_delay_ms": 2000 },
        "timeout_ms": 30000
      },
      {
        "id": "node_2",
        "type": "recap.summarize",
        "position": { "x": 400, "y": 120 },
        "config": {
          "content": "{{node_1.output.body}}",
          "prompt": "Write an executive weekly campaign digest: top movers, spend efficiency, conversion highlights and one recommended action per channel."
        },
        "retry": { "max_attempts": 2, "backoff": "exponential", "initial_delay_ms": 1000 },
        "timeout_ms": 30000
      },
      {
        "id": "node_3",
        "type": "recap.classify",
        "position": { "x": 400, "y": 380 },
        "config": {
          "content": "{{node_1.output.body}}",
          "categories": ["trending-up", "flat", "trending-down"]
        },
        "retry": { "max_attempts": 2, "backoff": "exponential", "initial_delay_ms": 1000 },
        "timeout_ms": 30000
      },
      {
        "id": "node_4",
        "type": "control.branch",
        "position": { "x": 700, "y": 380 },
        "config": {
          "condition": "{{node_3.output.category}} == trending-down"
        },
        "timeout_ms": 5000
      },
      {
        "id": "node_5",
        "type": "vault.create_document",
        "position": { "x": 750, "y": 120 },
        "config": {
          "title": "Campaign performance digest - {{trigger.scheduled_at}}",
          "content": "{{node_2.output.summary}}",
          "tags": ["marketing", "campaign", "weekly-report"]
        },
        "retry": { "max_attempts": 3, "backoff": "exponential", "initial_delay_ms": 1000 },
        "timeout_ms": 15000
      },
      {
        "id": "node_6",
        "type": "desk.send_notification",
        "position": { "x": 1000, "y": 300 },
        "config": {
          "channel": "{{variables.growth_channel}}",
          "title": "Campaign performance trending down",
          "body": "{{node_2.output.summary}}",
          "priority": "high"
        },
        "timeout_ms": 10000
      },
      {
        "id": "node_7",
        "type": "desk.send_notification",
        "position": { "x": 1100, "y": 100 },
        "config": {
          "channel": "{{variables.growth_channel}}",
          "title": "Weekly campaign digest ready",
          "body": "Trend: {{node_3.output.category}}\n{{node_2.output.summary}}",
          "priority": "normal"
        },
        "timeout_ms": 10000
      }
    ],
    "edges": [
      { "id": "e1", "source": "node_1", "source_port": "output", "target": "node_2", "target_port": "input" },
      { "id": "e2", "source": "node_1", "source_port": "output", "target": "node_3", "target_port": "input" },
      { "id": "e3", "source": "node_2", "source_port": "output", "target": "node_5", "target_port": "input" },
      { "id": "e4", "source": "node_3", "source_port": "output", "target": "node_4", "target_port": "input" },
      { "id": "e5", "source": "node_4", "source_port": "true", "target": "node_6", "target_port": "input" },
      { "id": "e6", "source": "node_5", "source_port": "output", "target": "node_7", "target_port": "input" }
    ],
    "variables": {
      "analytics_url": { "type": "string", "default": "https://analytics.internal/api/reports/campaigns/weekly" },
      "growth_channel": { "type": "string", "default": "#growth" }
    },
    "metadata": {
      "name": "Weekly Campaign Digest",
      "description": "Fetch Analytics → Summarize + Classify Trend → Publish + Notify (flag declines)",
      "tags": ["marketing", "campaign", "analytics", "weekly-report", "growth"]
    }
  }
}
