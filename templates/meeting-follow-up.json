{
  "name": "Meeting Follow-up Automation",
  "description": "End-to-end meeting follow-up: ingests transcript, extracts action items, summarizes, creates tasks with owners, schedules follow-up, and sends digest notification",
  "trigger": {
    "type": "event",
    "config": { "source": "recap", "event_type": "transcript.completed" }
  },
  "definition": {
    "version": "1.0",
    "nodes": [
      {
        "id": "node_1",
        "type": "recap.extract_action_items",
        "position": { "x": 100, "y": 200 },
        "config": {
          "transcript_id": "{{trigger.payload.transcript_id}}",
          "include_owners": true,
          "include_due_dates": true
        },
        "retry": { "max_attempts": 3, "backoff": "exponential", "initial_delay_ms": 1000 },
        "timeout_ms": 30000
      },
      {
        "id": "node_2",
        "type": "recap.summarize",
        "position": { "x": 100, "y": 450 },
        "config": {
          "transcript_id": "{{trigger.payload.transcript_id}}",
          "max_length": 300,
          "format": "executive_summary"
        },
        "retry": { "max_attempts": 3, "backoff": "exponential", "initial_delay_ms": 1000 },
        "timeout_ms": 30000
      },
      {
        "id": "node_3",
        "type": "desk.create_task",
        "position": { "x": 450, "y": 100 },
        "config": {
          "title": "{{node_1.output.action_item_title}}",
          "description": "From meeting: {{trigger.payload.meeting_title}}\nDue: {{node_1.output.due_date}}",
          "assignee": "{{node_1.output.owner}}",
          "priority": "high",
          "labels": ["meeting-follow-up"]
        },
        "retry": { "max_attempts": 2, "backoff": "fixed", "initial_delay_ms": 1000 },
        "timeout_ms": 10000
      },
      {
        "id": "node_4",
        "type": "vault.create_document",
        "position": { "x": 450, "y": 450 },
        "config": {
          "title": "Meeting Summary: {{trigger.payload.meeting_title}}",
          "content": "{{node_2.output.summary}}",
          "tags": ["meeting-summary", "{{trigger.payload.meeting_date}}"],
          "folder": "/meetings/{{trigger.payload.meeting_date}}"
        },
        "retry": { "max_attempts": 2, "backoff": "fixed", "initial_delay_ms": 1000 },
        "timeout_ms": 15000
      },
      {
        "id": "node_5",
        "type": "desk.create_calendar_event",
        "position": { "x": 750, "y": 450 },
        "config": {
          "title": "Follow-up: {{trigger.payload.meeting_title}}",
          "description": "48-hour follow-up on action items from {{trigger.payload.meeting_title}}.\n\nSummary: {{node_2.output.summary}}",
          "offset_hours": 48,
          "duration_minutes": 30,
          "attendees": ["{{trigger.payload.organizer}}"]
        },
        "timeout_ms": 10000
      },
      {
        "id": "node_6",
        "type": "desk.send_notification",
        "position": { "x": 1050, "y": 300 },
        "config": {
          "channel": "{{variables.notify_channel}}",
          "title": "✅ Meeting Follow-up Complete: {{trigger.payload.meeting_title}}",
          "body": "Tasks created: {{node_1.output.item_count}}\nSummary stored in Vault\nFollow-up scheduled in 48h",
          "priority": "normal"
        },
        "timeout_ms": 10000
      }
    ],
    "edges": [
      { "id": "e1", "source": "node_1", "source_port": "output", "target": "node_3", "target_port": "input" },
      { "id": "e2", "source": "node_2", "source_port": "output", "target": "node_4", "target_port": "input" },
      { "id": "e3", "source": "node_4", "source_port": "output", "target": "node_5", "target_port": "input" },
      { "id": "e4", "source": "node_3", "source_port": "output", "target": "node_6", "target_port": "input" },
      { "id": "e5", "source": "node_5", "source_port": "output", "target": "node_6", "target_port": "input" }
    ],
    "variables": {
      "notify_channel": { "type": "string", "default": "#meetings" }
    },
    "metadata": {
      "name": "Meeting Follow-up Automation",
      "description": "Event trigger → parallel (extract items + summarize) → tasks + KB doc → follow-up event → notify",
      "tags": ["meetings", "productivity", "automation"]
    }
  }
}
