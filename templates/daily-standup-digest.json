{
  "name": "Daily Standup Digest",
  "description": "Cron-triggered daily digest: collects task updates from Desk, summarizes with LLM, and posts to team channel",
  "definition": {
    "version": "1.0",
    "nodes": [
      {
        "id": "node_1",
        "type": "desk.list_tasks",
        "position": { "x": 100, "y": 200 },
        "config": { "status": "in_progress", "updated_since": "24h" }
      },
      {
        "id": "node_2",
        "type": "recap.summarize",
        "position": { "x": 400, "y": 200 },
        "config": {
          "content": "{{node_1.output.tasks}}",
          "prompt": "Summarize these task updates into a concise daily standup digest with blockers highlighted."
        }
      },
      {
        "id": "node_3",
        "type": "desk.send_notification",
        "position": { "x": 700, "y": 200 },
        "config": {
          "channel": "{{trigger.payload.channel}}",
          "message": "{{node_2.output.summary}}"
        }
      }
    ],
    "edges": [
      { "id": "e1", "source": "node_1", "source_port": "output", "target": "node_2", "target_port": "input" },
      { "id": "e2", "source": "node_2", "source_port": "output", "target": "node_3", "target_port": "input" }
    ],
    "variables": {},
    "metadata": { "name": "Daily Standup Digest", "description": "Automated daily standup summary from task updates", "tags": ["productivity", "cron", "team"] }
  }
}
