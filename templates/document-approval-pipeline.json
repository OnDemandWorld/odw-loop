{
  "name": "Document Approval Pipeline",
  "description": "Human-in-the-loop document review: classifies incoming documents, routes to approver, and stores approved documents in Vault with proper tagging",
  "trigger": {
    "type": "webhook",
    "config": { "secret": "{{secrets.webhook_secret}}" }
  },
  "definition": {
    "version": "1.0",
    "nodes": [
      {
        "id": "node_1",
        "type": "recap.classify",
        "position": { "x": 100, "y": 200 },
        "config": {
          "content": "{{trigger.payload.content}}",
          "categories": ["legal", "financial", "technical", "hr", "general"]
        },
        "retry": { "max_attempts": 2, "backoff": "exponential", "initial_delay_ms": 1000 },
        "timeout_ms": 20000
      },
      {
        "id": "node_2",
        "type": "control.approval",
        "position": { "x": 400, "y": 200 },
        "config": {
          "approvers": ["{{variables.approver_role}}"],
          "message": "Document pending review: {{trigger.payload.title}} (Category: {{node_1.output.category}})",
          "timeout_hours": 48
        },
        "timeout_ms": 172800000
      },
      {
        "id": "node_3",
        "type": "vault.create_document",
        "position": { "x": 700, "y": 100 },
        "config": {
          "title": "{{trigger.payload.title}}",
          "content": "{{trigger.payload.content}}",
          "tags": ["{{node_1.output.category}}", "approved"],
          "folder": "{{variables.vault_folder}}"
        },
        "retry": { "max_attempts": 3, "backoff": "exponential", "initial_delay_ms": 1000 },
        "timeout_ms": 15000
      },
      {
        "id": "node_4",
        "type": "desk.send_notification",
        "position": { "x": 700, "y": 350 },
        "config": {
          "channel": "{{variables.notify_channel}}",
          "title": "Document Rejected: {{trigger.payload.title}}",
          "body": "The document was not approved. Reason: {{node_2.output.rejection_reason}}",
          "priority": "high"
        },
        "timeout_ms": 10000
      }
    ],
    "edges": [
      { "id": "e1", "source": "node_1", "source_port": "output", "target": "node_2", "target_port": "input" },
      { "id": "e2", "source": "node_2", "source_port": "approved", "target": "node_3", "target_port": "input" },
      { "id": "e3", "source": "node_2", "source_port": "rejected", "target": "node_4", "target_port": "input" }
    ],
    "variables": {
      "approver_role": { "type": "string", "default": "compliance-officer" },
      "vault_folder": { "type": "string", "default": "/approved-documents" },
      "notify_channel": { "type": "string", "default": "#compliance" }
    },
    "metadata": {
      "name": "Document Approval Pipeline",
      "description": "Classify → Approval Gate → Store (approved) or Notify (rejected)",
      "tags": ["compliance", "approval", "documents"]
    }
  }
}
